programa {
  funcao inicio() {
    inteiro idade 
    cadeia nome 
    escreva ("sua idade: ")
    leia(idade)
    escreva("seu nome:")
    leia (nome)

    se(idade < 18){
     escreva("voce é menor, pode entrar.")


    }
    se(idade > 18){
      escreva( "você  não é menor, nao pode entrar.")
      escreva("\nEncontre um menor resposavel.")
    }
      se(nome =="glauber"){
        escreva("\nvoce esta no vip")
      }
      se(nome !="glauber"){
      escreva("voce pode entrar na lista vip...")
      }
    se(idade >60){
      escreva("aqui tu ja esta so o pó mas tem asilo bem pertinho aqui...")
    }
    se (idade ==30){
      escreva("\nVoce pode criar uma banda hoje")
     
     escreva("\nvolte semana que vem")
    }

 


    ///////////////////////////////////////////////////// fim do mundo, precipício da antártica. Muro da terra plana.
  }
}
